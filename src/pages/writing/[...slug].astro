---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("writing")).filter(
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title.toLowerCase()}>
  <main class="writing-post mb-8 flex flex-col gap-4">
    <header class="flex items-baseline justify-between gap-4">
      <h1 class="text-lg font-bold lowercase">{post.data.title}</h1>
      <time
        class="text-right text-sm whitespace-nowrap text-slate-500"
        datetime={post.data.date.toISOString()}
      >
        {post.data.date.toISOString().slice(0, 10)}
      </time>
    </header>
    <Content />
  </main>
</BaseLayout>
