---
import BaseLayout from "../../layouts/BaseLayout.astro";

import "../../styles/global.css";
import gardenLinks from "../../data/garden.json";
---

<BaseLayout title="Garden">
  <div class="mb-8 flex w-full flex-col gap-6">
    <p>Welcome to my garden</p>
    {
      gardenLinks.map(({ section, links }) => (
        <div class="flex w-full">
          <h5 class="w-20 font-bold">{section}</h5>
          <div class="flex flex-1 flex-col gap-2">
            {links.map(
              ({
                name,
                link,
                description,
              }: {
                name: string;
                link: string;
                description?: string;
              }) => (
                <div class="flex w-full items-baseline justify-between">
                  <a href={link} rel="noopener noreferrer">
                    {name}
                  </a>
                  {description && (
                    <span class="text-sm text-slate-500">{description}</span>
                  )}
                </div>
              ),
            )}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
