---
import { getCollection } from "astro:content";
import type { AnyEntryMap } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const getEntries = async (collection: keyof AnyEntryMap) => {
    const entries = await getCollection(collection);
    return entries.map((entry) => ({
      params: { slug: `${collection}/${entry.slug}` },
      props: { entry },
    }));
  };

  const blogEntries = await getEntries("blog");
  const draftEntries = await getEntries("draft");

  return [...blogEntries, ...draftEntries];
}

const { entry }: any = Astro.props;
const { Content } = await entry.render();
const postData = entry.data;
---

<script>
  window.onscroll = () => {
    var winScroll =
      document.body.scrollTop || document.documentElement.scrollTop;
    var height =
      document.documentElement.scrollHeight -
      document.documentElement.clientHeight;
    var scrolled = (winScroll / height) * 100;

    const element = document.getElementById("progress-bar");
    if (element) element.style.width = scrolled + "%";
  };
</script>

<BaseLayout title={postData.title.toLowerCase()}>
  <div class="fixed top-0 left-0 h-1 w-full">
    <div class="bg-orange h-1 w-0" id="progress-bar"></div>
  </div>
  <main class="mb-8 flex flex-col gap-4">
    <h1 class="text-lg font-bold lowercase">{postData.title}</h1>
    <p class="text-muted text-sm lowercase">Published: {postData.pubDate}</p>
    <div class="post-content">
      <Content />
    </div>
  </main>
</BaseLayout>
