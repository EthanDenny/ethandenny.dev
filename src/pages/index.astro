---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import projects from "../data/projects.json";

const workLink = "https://www.spellbook.com/";
const schoolLink = "https://www.mun.ca/";
const demoNightLink = "/demo-night/";
const writing = (await getCollection("writing"))
  .filter(({ data }) => import.meta.env.DEV || !data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout>
  <main class="flex flex-col gap-8 lowercase">
    <section id="now" class="flex scroll-mt-8 flex-col gap-4">
      <h4 class="text-lg font-bold">Now</h4>
      <div class="flex flex-col gap-2">
        <p>
          building the future of contracts at <a href={workLink}>spellbook</a>
        </p>
        <p>hosting <a href={demoNightLink}>demo nights</a> in st. john's</p>
        <p>
          just graduated from <a href={schoolLink}>mun</a> with my bachelors in computer
          science
        </p>
        <p>canadian 🇨🇦</p>
      </div>
    </section>

    <section id="projects" class="flex scroll-mt-8 flex-col gap-4">
      <h4 class="text-lg font-bold">Favourite projects</h4>
      <div class="flex flex-col gap-2">
        {
          projects.map(({ name, description, link }) => (
            <div class="flex w-full items-baseline justify-between gap-4">
              <a href={link} target="_blank" rel="noopener noreferrer">
                {name}
              </a>
              {description && (
                <span class="text-right text-sm text-slate-500">
                  {description}
                </span>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section id="writing" class="flex scroll-mt-8 flex-col gap-4">
      <div class="flex items-baseline justify-between gap-4">
        <h4 class="text-lg font-bold">Writing</h4>
        <a class="text-sm" href="/rss.xml">rss</a>
      </div>
      <div class="flex flex-col gap-2">
        {
          writing.map(({ id, data }) => (
            <div class="flex w-full items-baseline justify-between gap-4">
              <a href={`/writing/${id}`}>{data.title}</a>
              <time
                class="text-right text-sm whitespace-nowrap text-slate-500"
                datetime={data.date.toISOString()}
              >
                {data.date.toISOString().slice(0, 10)}
              </time>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
