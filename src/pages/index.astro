---
import BaseLayout from "../layouts/BaseLayout.astro";
import Divider from "../components/Divider.astro";
import Footer from "../components/Footer.astro";

const workLink = "https://www.spellbook.legal/";
const schoolLink = "https://www.mun.ca/";
---

<BaseLayout title={"Home"}>
  <div class="flex flex-col gap-4">
    <p>I like building software, listening to music, and playing games.</p>
    <p>
      {"Right now, I'm building AI for lawyers as a software developer at"}
      <a href={workLink}>Spellbook</a>{
        " and finishing my bachelor's degree in computer science at"
      }
      <a href={schoolLink}>MUN</a>. I also host <a
        href="https://ethandenny.dev/demo-night">Demo Night</a
      >, an approximately-quarterly meet up focused around short talks & demos,
      by professionals, for professionals.
    </p>
  </div>
  <Divider />
  <Footer />
</BaseLayout>
