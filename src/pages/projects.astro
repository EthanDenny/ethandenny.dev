---
import BaseLayout from "../layouts/BaseLayout.astro";

import "../styles/global.css";

import projects from "../data/projects.json";
---

<BaseLayout title="Projects">
  <div class="mb-8 flex flex-col gap-6">
    <p>
      Not an exhaustive list, there's more to see on my <a
        href="https://github.com/EthanDenny">GitHub</a
      >
    </p>
    {
      projects.map(({ year, links }) => (
        <div class="flex w-full">
          <h5 class="w-20 font-bold">{year}</h5>
          <div class="flex flex-1 flex-col gap-2">
            {links.map(({ name, description, link }) => (
              <div class="flex w-full items-baseline justify-between">
                <a href={link} rel="noopener noreferrer">
                  {name}
                </a>
                {description && (
                  <span class="text-sm text-slate-500">{description}</span>
                )}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
