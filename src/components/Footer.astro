---
import ContactLink from "./ContactLink.astro";
import Computer from "@lucide/astro/icons/computer";
import FileUser from "@lucide/astro/icons/file-user";
import Users from "@lucide/astro/icons/users";
---

<footer class="flex flex-col gap-4">
  <p>
    Want to know more about me? Check out one of the other places I exist
    online:
  </p>
  <div class="flex gap-6">
    <ContactLink
      icon={Computer}
      href="https://github.com/EthanDenny"
      label="Github"
    />
    <ContactLink
      icon={Users}
      href="https://www.linkedin.com/in/ethan-denny-709/"
      label="LinkedIn"
    />
    <ContactLink
      icon={FileUser}
      href="https://ethandenny.dev/resume"
      label="Resume"
    />
  </div>
</footer>
